/* =====================================================================
   ROFI - Janela centralizada combinando com a paleta usada no
   Waybar/Alacritty/swaync/hyprlock. Fundo frio (#181a1f/#121212),
   acentos em azul (#3F68EE / #00BFFF). Era sidebar (location: west);
   trocado pra centro a pedido do usuário em 2026-08-29.
   ===================================================================== */

* {
    font: "JetBrainsMono Nerd Font 11";

    bg0:      #181a1f;
    bg1:      #121212;
    fg0:      #D6EBFF;
    fg-dim:   #5c6370;
    accent:   #3F68EE;
    accent2:  #00BFFF;
    urgent:   #E5A4AA;

    text-color:       @fg0;
    background-color: transparent;
}

window {
    width:           32em;
    location:        center;
    anchor:          center;
    background-color: @bg1;
    border:          2px;
    border-radius:   10px;
    border-color:    @accent;
}

mainbox {
    expand:            true;
    background-color:  @bg1;
    spacing:           0.6em;
    padding:           0.8em;
}

inputbar {
    background-color: @bg0;
    text-color:        @fg0;
    padding:           10px 12px;
    border:            1px;
    border-color:      @accent;
    border-radius:     4px;
    children:          [ "prompt", "entry" ];
}

prompt {
    text-color: @accent2;
    padding:    0px 8px 0px 0px;
}

entry {
    placeholder:       "Buscar...";
    placeholder-color: @fg-dim;
}

mode-switcher {
    border:            2px 0px 0px 0px;
    border-color:      @accent;
    background-color:  @bg0;
    padding:           4px;
    spacing:           4px;
}

button {
    background-color: transparent;
    text-color:        @fg-dim;
    border-radius:     4px;
    padding:           6px;
}

button selected {
    background-color: @accent;
    text-color:        @bg1;
}

listview {
    padding:    0.4em 0em;
    dynamic:    false;
    lines:      12;
    spacing:    2px;
    scrollbar:  false;
}

element {
    padding:           8px 10px;
    border-radius:     4px;
    background-color:  transparent;
}

element-icon {
    size:            1.2em;
    vertical-align:  0.5;
}

element-text {
    background-color: inherit;
    text-color:        inherit;
    vertical-align:    0.5;
}

element normal normal { text-color: @fg0; }
element normal urgent { text-color: @urgent; }
element normal active { text-color: @accent2; }

element selected normal {
    background-color: @accent;
    text-color:        @bg1;
}

element selected urgent {
    background-color: @urgent;
    text-color:        @bg1;
}

element selected active {
    background-color: @accent2;
    text-color:        @bg1;
}

error-message {
    background-color: @bg1;
    text-color:        @urgent;
    border:            1px;
    border-color:      @urgent;
    border-radius:     4px;
    padding:           1em;
}
